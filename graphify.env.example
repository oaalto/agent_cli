# Graphify extraction backend — operator-owned credentials.
# Copy values to your shell profile or `source` this file (after filling placeholders).
# ADC does not store secrets in bundles. See .agentic-config/INSTALL.md § Graphify extraction backend.

# --- Gemini (recommended for doc-heavy repos) ---
# uv tool install 'graphifyy[mcp,gemini]' --force
# GEMINI_API_KEY=your-gemini-api-key
# GOOGLE_API_KEY=your-google-api-key

# --- OpenAI-compatible (cloud or Aura proxy) ---
# uv tool install 'graphifyy[mcp,openai]' --force
# OPENAI_API_KEY=your-project-api-key
# OPENAI_BASE_URL=https://your-aura-host/v1
# OPENAI_MODEL=your-model-alias

# --- Anthropic ---
# uv tool install 'graphifyy[mcp,anthropic]' --force
# ANTHROPIC_API_KEY=your-anthropic-api-key

# --- Ollama (local) ---
# uv tool install 'graphifyy[mcp,ollama]' --force
# OLLAMA_BASE_URL=http://localhost:11434

# --- DeepSeek / Moonshot ---
# uv tool install 'graphifyy[mcp,deepseek]' --force
# DEEPSEEK_API_KEY=your-deepseek-api-key
# MOONSHOT_API_KEY=your-moonshot-api-key
